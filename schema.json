{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "organization",
    "document_number",
    "document_date",
    "subject",
    "inn",
    "amount",
    "currency",
    "counterparty",
    "evidence"
  ],
  "properties": {
    "document_type": {
      "enum": [
        "Договор",
        "Дополнительное соглашение",
        "Счет",
        "Счет-фактура",
        "Акт",
        "Накладная",
        "УПД",
        "Платежный документ",
        "Письмо",
        "Прочее",
        null
      ]
    },
    "organization": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "inn": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^([0-9]{10}|[0-9]{12})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "amount": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+([.][0-9]{1,2})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "enum": [
        "RUB",
        "USD",
        "EUR",
        "CNY",
        "GBP",
        null
      ]
    },
    "counterparty": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "organization",
        "document_number",
        "document_date",
        "subject",
        "inn",
        "amount",
        "currency",
        "counterparty"
      ],
      "properties": {
        "document_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        },
        "document_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "document_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "inn": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "counterparty": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
